# Copie para .env (na raiz do repositório) e preencha.

# --- LLM (qualquer API no formato OpenAI; padrão: OpenRouter) ---
# Chave em https://openrouter.ai/keys
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT=30

# --- Acesso ao Biony ---
# Token que os clientes mandam em "Authorization: Bearer ...". Mínimo de 24 caracteres.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
BIONY_API_TOKEN=

# Senha da PWA (mínimo 8 caracteres). Cada aparelho que entra ganha um token próprio.
# BIONY_PASSWORD=

# --- Home Assistant (opcional; sem isso o Biony não controla a casa) ---
# Token: no HA, Perfil → Segurança → Tokens de acesso de longa duração.
# 172.17.0.1 é o próprio servidor visto de dentro do container (HA em network_mode: host).
# HA_URL=http://172.17.0.1:8123
# HA_TOKEN=
# O que o Biony pode controlar fica em config/casa.toml.

# --- Voz (faster-whisper + Piper, tudo local) ---
# VOICE_ENABLED=true
# STT_MODEL=small          # base = mais rápido e erra mais; small = melhor em PT-BR
# STT_BEAM_SIZE=1          # 5 = um pouco mais preciso e mais lento
# TTS_VOICE=pt_BR-faber-medium   # outras: pt_BR-jeff-medium, pt_BR-cadu-medium, pt_BR-edresson-low
# TTS_REDUCE_NOISE=false        # true corta o chiado de fundo (recomendado para a jeff)
# Voz na nuvem pelo Azure (o Piper acima vira a reserva se o Azure falhar).
# portal.azure.com → Speech services (Free F0, região Brazil South) → Keys and Endpoint → KEY 1.
# Ouça as vozes em speech.microsoft.com/portal/voicegallery (Portuguese (Brazil)).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth
# AZURE_TTS_VOICE=pt-BR-AntonioNeural
# AZURE_TTS_PITCH=0%            # ex.: -10% = mais grave
# AZURE_TTS_RATE=0%             # ex.: -5% = mais devagar
# Transcrição na nuvem pela Groq (bem mais precisa e rápida; o Whisper local vira reserva).
# Chave em https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Agente do PC (clients/pc-agente): ligar/desligar o PC com segurança ---
# O instalar.ps1 mostra estas duas linhas prontas.
# PC_AGENT_URL=http://IP_TAILSCALE_DO_PC:8421
# PC_AGENT_TOKEN=
# PC_SETUP_DEVICE=setup        # aparelho do casa.toml que é o filtro do PC

# --- Tuya (nuvem): botões de controles IR que o HA não mostra (TV etc.) ---
# Projeto em platform.tuya.com → Cloud → Development → Overview → Access ID / Access Secret.
# Se o projeto tiver "IP whitelist", o IP de casa precisa estar nela (erro 1114).
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
# TUYA_REGION=us               # us = Western America (contas do Brasil); eu, cn, in

# --- Telegram (notificações e conversa) ---
# Crie o bot com o @BotFather (/newbot) e cole o token aqui.
# TELEGRAM_BOT_TOKEN=
# Mande uma mensagem pro bot: ele responde com o seu chat id. Só esse chat é atendido.
# TELEGRAM_CHAT_ID=

# --- Avisos automáticos de prazo ---
# BIONY_DEADLINE_DAYS=3,1,0     # dias antes do prazo (0 = no dia)
# BIONY_DEADLINE_TIME=09:00
# BIONY_QUIET_START=22:30       # nada de aviso automático entre START e END
# BIONY_QUIET_END=07:00

# --- Cliente do PC (clients/pc/biony_voz.py) ---
# BIONY_URL=http://IP_TAILSCALE_DO_SERVIDOR:8420

# --- Opcionais ---
# BIONY_USER_NAME=Lucas
# BIONY_PERSONALITY=equilibrado   # inicial: equilibrado, serio, divertido, jarvis (depois troca conversando)
# BIONY_TIMEZONE=America/Sao_Paulo
# BIONY_HISTORY_MESSAGES=30
# BIONY_DB_PATH=data/biony.sqlite3   (no Docker já é /data/biony.sqlite3)
