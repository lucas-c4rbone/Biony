# Arquivo de exemplo para configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves de API

# API Key do OpenRouter (obtenha em https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modelo do OpenRouter (padrão: deepseek/deepseek-chat)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Timeout da API em segundos (padrão: 30.0)
OPENROUTER_TIMEOUT=30.0

# Para uso com OpenAI (opcional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT=30.0

# Para uso com openWakeWord (opcional)
# OPENWAKEWORD_MODEL_PATH=
# OPENWAKEWORD_THRESHOLD=0.5

# Para uso com STT/TTS (opcional)
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy