# Copie para .env (na raiz do repositório) e preencha.

# --- LLM (qualquer API no formato OpenAI; padrão: OpenRouter) ---
# Chave em https://openrouter.ai/keys
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_TIMEOUT=30

# --- Acesso ao Biony ---
# Token que os clientes mandam em "Authorization: Bearer ...". Mínimo de 24 caracteres.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
BIONY_API_TOKEN=

# --- Home Assistant (opcional; sem isso o Biony não controla a casa) ---
# Token: no HA, Perfil → Segurança → Tokens de acesso de longa duração.
# 172.17.0.1 é o próprio servidor visto de dentro do container (HA em network_mode: host).
# HA_URL=http://172.17.0.1:8123
# HA_TOKEN=
# O que o Biony pode controlar fica em config/casa.toml.

# --- Opcionais ---
# BIONY_USER_NAME=Lucas
# BIONY_TIMEZONE=America/Sao_Paulo
# BIONY_HISTORY_MESSAGES=30
# BIONY_DB_PATH=data/biony.sqlite3   (no Docker já é /data/biony.sqlite3)
